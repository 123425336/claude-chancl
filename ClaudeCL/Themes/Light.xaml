<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：奶油纸张底色 + 陶土橙点缀，与看板娘的配色呼应 -->
    <Color x:Key="AccentColor">#D97757</Color>
    <Color x:Key="ShadowColor">#5A4632</Color>
    <Color x:Key="BgColor">#F4EFE6</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#F4EFE6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAF7F2"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFDF9"/>
    <SolidColorBrush x:Key="SideBrush" Color="#EEE7DB"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFDF9"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EAE2D5"/>
    <SolidColorBrush x:Key="PressBrush" Color="#E0D6C6"/>

    <SolidColorBrush x:Key="TextBrush" Color="#2A251F"/>
    <SolidColorBrush x:Key="TextSoftBrush" Color="#6E655A"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#A0968A"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#D97757"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#CB6A49"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#B5583A"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F7E3D8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E4DACB"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D3C6B3"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#5E8C5A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E3EEDC"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C24E3B"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F6DEDA"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#BE9455"/>
    <SolidColorBrush x:Key="InkBrush" Color="#2A251F"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#5C2A2018"/>
    <SolidColorBrush x:Key="CodeBrush" Color="#F1EBE1"/>

    <!-- 主页背景的柔光渐变 -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBF4EA" Offset="0"/>
        <GradientStop Color="#F6E6D8" Offset="0.6"/>
        <GradientStop Color="#F1D9C8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4EFE6" Offset="0"/>
        <GradientStop Color="#E6F4EFE6" Offset="0.45"/>
        <GradientStop Color="#00F4EFE6" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
