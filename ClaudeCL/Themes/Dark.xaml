<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：夜读的炭灰底色 + 暖橙灯光 -->
    <Color x:Key="AccentColor">#E3896A</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="BgColor">#1D1B18</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#1D1B18"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#23211D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2A2723"/>
    <SolidColorBrush x:Key="SideBrush" Color="#181613"/>
    <SolidColorBrush x:Key="InputBrush" Color="#221F1C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#34302B"/>
    <SolidColorBrush x:Key="PressBrush" Color="#3E3933"/>

    <SolidColorBrush x:Key="TextBrush" Color="#EEE7DB"/>
    <SolidColorBrush x:Key="TextSoftBrush" Color="#ADA395"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#776E63"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#E3896A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EC9A7D"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#CF7556"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3D2B23"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#3A352F"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4C463E"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#8DB886"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#26331F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E3826E"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B231E"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#D2AD72"/>
    <SolidColorBrush x:Key="InkBrush" Color="#EEE7DB"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>
    <SolidColorBrush x:Key="CodeBrush" Color="#191714"/>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24211D" Offset="0"/>
        <GradientStop Color="#2B231E" Offset="0.6"/>
        <GradientStop Color="#33251E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1D1B18" Offset="0"/>
        <GradientStop Color="#E61D1B18" Offset="0.45"/>
        <GradientStop Color="#661D1B18" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
