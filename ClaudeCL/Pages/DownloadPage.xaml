<UserControl x:Class="ClaudeCL.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <Grid Margin="36,6,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="下载游戏" Style="{StaticResource T.H1}"/>
            <TextBlock Text="挑一个版本，剩下的交给我。" Style="{StaticResource T.Soft}" Margin="0,4,0,16"/>
        </StackPanel>

        <!-- 筛选 -->
        <DockPanel Grid.Row="1" Margin="0,0,20,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE72C;" ToolTip="刷新列表" Click="Refresh_Click" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" x:Name="SearchBox" Width="200" c:Ui.Placeholder="搜索版本号" TextChanged="Filter_Changed"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ReleaseChip" Style="{StaticResource Chip}" Content="正式版" GroupName="DlType" IsChecked="True" Checked="Filter_Changed"/>
                <RadioButton x:Name="SnapshotChip" Style="{StaticResource Chip}" Content="快照" GroupName="DlType" Checked="Filter_Changed"/>
                <RadioButton x:Name="OldChip" Style="{StaticResource Chip}" Content="远古版本" GroupName="DlType" Checked="Filter_Changed"/>
            </StackPanel>
        </DockPanel>

        <!-- 版本列表 -->
        <Grid Grid.Row="2" Margin="0,0,20,0">
            <ListBox x:Name="VersionList" Style="{StaticResource CardList}" SelectionChanged="VersionList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource T.Caption}">
                                    <Run Text="{Binding TypeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ReleaseTime, StringFormat=yyyy 年 M 月 d 日, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 加载 / 出错 状态 -->
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:SparkLoader Width="44" Height="44"/>
                <TextBlock Text="正在翻阅版本目录……" Style="{StaticResource T.Soft}" Margin="0,14,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Image Source="/Assets/reading.png" Width="140" Opacity="0.9"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource T.Soft}" TextAlignment="Center" MaxWidth="360" Margin="0,10,0,12"/>
                <Button Content="再试一次" HorizontalAlignment="Center" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- 右侧安装卡片 -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" Text="选一个版本" Style="{StaticResource T.H2}" FontSize="20"/>
                <TextBlock x:Name="DetailSub" Text="在左边点一下想玩的版本。" Style="{StaticResource T.Soft}" Margin="0,4,0,0"/>

                <StackPanel x:Name="InstallForm" IsEnabled="False" Margin="0,18,0,0">
                    <TextBlock Text="版本名称" Style="{StaticResource T.Label}"/>
                    <TextBox x:Name="NameBox" c:Ui.Placeholder="安装后显示的名字"/>

                    <TextBlock Text="模组加载器" Style="{StaticResource T.Label}" Margin="0,16,0,6"/>
                    <WrapPanel>
                        <RadioButton x:Name="VanillaChip" Style="{StaticResource Chip}" Content="不安装" GroupName="Loader" IsChecked="True" Checked="Loader_Changed" Margin="0,0,6,6"/>
                        <RadioButton x:Name="ForgeChip" Style="{StaticResource Chip}" Content="Forge" GroupName="Loader" Checked="Loader_Changed" Margin="0,0,6,6"/>
                        <RadioButton x:Name="NeoForgeChip" Style="{StaticResource Chip}" Content="NeoForge" GroupName="Loader" Checked="Loader_Changed" Margin="0,0,6,6"/>
                        <RadioButton x:Name="FabricChip" Style="{StaticResource Chip}" Content="Fabric" GroupName="Loader" Checked="Loader_Changed" Margin="0,0,6,6"/>
                        <RadioButton x:Name="QuiltChip" Style="{StaticResource Chip}" Content="Quilt" GroupName="Loader" Checked="Loader_Changed" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <StackPanel x:Name="LoaderPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <ComboBox x:Name="LoaderBox" SelectionChanged="LoaderBox_SelectionChanged"/>
                        <TextBlock x:Name="LoaderHint" Style="{StaticResource T.Caption}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <CheckBox x:Name="OptiFineCheck" Content="同时安装 OptiFine" Margin="0,16,0,0" Click="OptiFine_Click"/>
                    <StackPanel x:Name="OptiFinePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <ComboBox x:Name="OptiFineBox" SelectionChanged="OptiFineBox_SelectionChanged"/>
                        <TextBlock x:Name="OptiFineHint" Style="{StaticResource T.Caption}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="InstallButton" Content="安装" Style="{StaticResource Btn.Primary}" Height="42" Margin="0,22,0,0"
                            c:Ui.Icon="&#xE896;" Click="Install_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
