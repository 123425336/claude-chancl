<UserControl x:Class="ClaudeCL.Pages.VersionDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <Grid Margin="30,2,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 版本名 + 操作 -->
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE72B;" ToolTip="返回主页" Click="Back_Click"
                    VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="打开文件夹" c:Ui.Icon="&#xE8B7;" Padding="14,7" Margin="0,0,8,0" Click="Folder_Click"/>
                <Button Content="启动" Style="{StaticResource Btn.Primary}" c:Ui.Icon="&#xE768;" Padding="18,7" Click="Launch_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource T.H1}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubText" Style="{StaticResource T.Soft}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 标签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="ModsTab" Style="{StaticResource Chip}" Content="模组" GroupName="DetailTab" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="LoaderTab" Style="{StaticResource Chip}" Content="加载器" GroupName="DetailTab" Checked="Tab_Checked"/>
        </StackPanel>

        <!-- 模组 -->
        <Grid x:Name="ModsPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,8,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- 模组更新检查的状态 -->
                    <StackPanel x:Name="UpdateChecking" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                        <c:SparkLoader Width="18" Height="18"/>
                        <TextBlock Text="正在检查模组更新……" Style="{StaticResource T.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="UpdateAllButton" Content="全部更新" Style="{StaticResource Btn.Primary}" c:Ui.Icon="&#xE896;" Padding="12,7"
                            Margin="0,0,6,0" Visibility="Collapsed" Click="UpdateAll_Click"/>
                    <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE72C;" ToolTip="刷新" Click="Refresh_Click"/>
                    <Button Content="添加模组" c:Ui.Icon="&#xE710;" Padding="12,7" Margin="6,0,0,0" Click="AddMods_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="220" c:Ui.Placeholder="搜索模组" c:Ui.Clearable="True" TextChanged="Filter_Changed" Margin="0,0,12,0"/>
                    <RadioButton x:Name="AllChip" Style="{StaticResource Chip}" Content="全部" GroupName="ModFilter" IsChecked="True" Checked="Filter_Changed"/>
                    <RadioButton x:Name="OnChip" Style="{StaticResource Chip}" Content="已启用" GroupName="ModFilter" Checked="Filter_Changed"/>
                    <RadioButton x:Name="OffChip" Style="{StaticResource Chip}" Content="已停用" GroupName="ModFilter" Checked="Filter_Changed"/>
                </StackPanel>
            </DockPanel>

            <ListBox x:Name="ModList" Grid.Row="1" Style="{StaticResource CardList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource SerifFont}" FontSize="19"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                    <Run Text="{Binding Subtitle, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Soft}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource T.Caption}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 有新版时显示 -->
                                <StackPanel x:Name="UpdateBox" Orientation="Horizontal" Margin="0,0,14,0" Visibility="Collapsed">
                                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UpdateText}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Button Content="更新" Style="{StaticResource Btn.Primary}" Padding="12,5" Tag="{Binding}" Click="Update_Click"
                                            ToolTip="去资源中心查看新版并下载"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" Tag="{Binding}" ToolTip="启用 / 停用"/>
                                <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE74D;" ToolTip="移到回收站" Margin="8,0,0,0"
                                        Tag="{Binding}" Click="Delete_Click" c:Ui.HoverBackground="{DynamicResource DangerSoftBrush}"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <Setter TargetName="UpdateBox" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="ModsLoading" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <c:SparkLoader Width="40" Height="40"/>
                <TextBlock Text="正在清点书架上的模组……" Style="{StaticResource T.Soft}" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ModsEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Image Source="/Assets/reading.png" Width="140"/>
                <TextBlock x:Name="ModsEmptyText" Style="{StaticResource T.Soft}" TextAlignment="Center" MaxWidth="380" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 加载器 -->
        <ScrollViewer x:Name="LoaderPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0" MaxWidth="720" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="当前加载器" Style="{StaticResource T.Label}"/>
                        <TextBlock x:Name="CurrentLoaderText" Style="{StaticResource T.H2}" FontSize="20"/>
                        <TextBlock x:Name="GameVersionText" Style="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="切换加载器或版本" Style="{StaticResource T.H2}"/>
                        <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
                                   Text="存档、设置和 mods 文件夹都会保留。不同加载器的模组互不通用，换成别的加载器后记得调整模组。"/>
                        <WrapPanel>
                            <RadioButton x:Name="SwVanilla" Style="{StaticResource Chip}" Content="原版" GroupName="SwLoader" Checked="SwLoader_Checked" Margin="0,0,6,6"/>
                            <RadioButton x:Name="SwForge" Style="{StaticResource Chip}" Content="Forge" GroupName="SwLoader" Checked="SwLoader_Checked" Margin="0,0,6,6"/>
                            <RadioButton x:Name="SwNeoForge" Style="{StaticResource Chip}" Content="NeoForge" GroupName="SwLoader" Checked="SwLoader_Checked" Margin="0,0,6,6"/>
                            <RadioButton x:Name="SwFabric" Style="{StaticResource Chip}" Content="Fabric" GroupName="SwLoader" Checked="SwLoader_Checked" Margin="0,0,6,6"/>
                            <RadioButton x:Name="SwQuilt" Style="{StaticResource Chip}" Content="Quilt" GroupName="SwLoader" Checked="SwLoader_Checked" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <ComboBox x:Name="SwVersionBox" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SwHint" Style="{StaticResource T.Caption}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                        <Button x:Name="SwitchButton" Content="切换到这个版本" Style="{StaticResource Btn.Primary}" Height="40" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Padding="22,0" Click="Switch_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
