<UserControl x:Class="ClaudeCL.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <Grid Margin="36,6,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="版本管理" Style="{StaticResource T.H1}"/>
            <TextBlock Text="书架上的每一本书，都是一个世界。" Style="{StaticResource T.Soft}" Margin="0,4,0,16"/>
        </StackPanel>

        <!-- 游戏目录 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,8,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="更换" Padding="14,6" Margin="8,0,0,0" Click="ChangeDir_Click"/>
                <Button DockPanel.Dock="Right" Content="打开" Padding="14,6" Margin="8,0,0,0" Click="OpenDir_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE72C;" ToolTip="重新扫描" Click="Rescan_Click"/>
                <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="游戏目录" Style="{StaticResource T.Caption}"/>
                    <TextBlock x:Name="DirText" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Hover}" Margin="0,0,0,10" Padding="16,12" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Card_Click" ToolTip="点击管理模组与加载器">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource T.Icon}" FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version.Id}" FontWeight="SemiBold" FontSize="14.5"/>
                                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding CurrentVisibility}">
                                                <TextBlock Text="当前" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Version.Summary}" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="启动" Style="{StaticResource Btn.Primary}" Padding="14,6" Margin="0,0,6,0" Tag="{Binding}" Click="Launch_Click"
                                                IsEnabled="{Binding Version.IsValid}"/>
                                        <Button Content="设为当前" Padding="12,6" Margin="0,0,6,0" Tag="{Binding}" Click="Select_Click"
                                                IsEnabled="{Binding Version.IsValid}"/>
                                        <Button Content="管理" Padding="12,6" Margin="0,0,6,0" c:Ui.Icon="&#xEA86;" ToolTip="管理模组、切换加载器" Tag="{Binding}" Click="Mods_Click"/>
                                        <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE8B7;" ToolTip="打开文件夹" Tag="{Binding}" Click="Folder_Click"/>
                                        <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE90F;" ToolTip="检查并补全文件" Tag="{Binding}" Click="Repair_Click"/>
                                        <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE74D;" ToolTip="删除（移到回收站）" Tag="{Binding}" Click="Delete_Click"
                                                c:Ui.HoverBackground="{DynamicResource DangerSoftBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Image Source="/Assets/reading.png" Width="160"/>
                <TextBlock Text="书架还是空的呢" Style="{StaticResource T.H2}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="去「下载游戏」挑一个版本放上来吧。" Style="{StaticResource T.Soft}" HorizontalAlignment="Center"/>
                <Button Content="去下载" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="GoDownload_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
