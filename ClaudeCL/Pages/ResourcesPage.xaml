<UserControl x:Class="ClaudeCL.Pages.ResourcesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <Grid Margin="36,6,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="资源中心" Style="{StaticResource T.H1}"/>
            <TextBlock Text="模组、资源包和光影，都会装进你选择的版本里。" Style="{StaticResource T.Soft}" Margin="0,4,0,16"/>
        </StackPanel>

        <!-- 筛选栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ModChip" Style="{StaticResource Chip}" Content="模组" GroupName="ResType" IsChecked="True" Checked="Type_Changed"/>
                <RadioButton x:Name="PackChip" Style="{StaticResource Chip}" Content="资源包" GroupName="ResType" Checked="Type_Changed"/>
                <RadioButton x:Name="ShaderChip" Style="{StaticResource Chip}" Content="光影" GroupName="ResType" Checked="Type_Changed"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,10,0" c:Ui.Placeholder="搜索，例如 钠、小地图、JEI……（按回车）" c:Ui.Clearable="True"
                     KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="TargetBox" Grid.Column="2" SelectionChanged="Target_Changed" ToolTip="安装到哪个版本">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="装到 "/><Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="NoTargetHint" Grid.Column="2" Text="还没有安装版本" Style="{StaticResource T.Caption}"
                       VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <ItemsControl x:Name="Results">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Hover}" Margin="0,0,0,10" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock>
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14.5"/>
                                                <Run Text="{Binding Author, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Soft}" FontSize="12.5" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0">
                                                <Run Text="&#xE896;" FontFamily="{StaticResource IconFont}"/><Run Text="{Binding DownloadsText, StringFormat=' {0} 次下载', Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="安装" Style="{StaticResource Btn.Primary}" Padding="18,7" c:Ui.Icon="&#xE896;"
                                                    Click="Install_Click" Tag="{Binding}"/>
                                            <Button Content="详情" Style="{StaticResource Btn.Ghost}" Padding="10,5" Margin="0,4,0,0"
                                                    Click="Detail_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MoreButton" Content="加载更多" HorizontalAlignment="Center" Margin="0,4,0,10" Visibility="Collapsed" Click="More_Click"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <c:SparkLoader Width="44" Height="44"/>
                <TextBlock Text="正在书架上翻找……" Style="{StaticResource T.Soft}" Margin="0,14,0,0"/>
            </StackPanel>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Image Source="/Assets/reading.png" Width="150"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource T.Soft}" TextAlignment="Center" MaxWidth="380" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
