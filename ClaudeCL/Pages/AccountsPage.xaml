<UserControl x:Class="ClaudeCL.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <Grid Margin="36,6,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="账号" Style="{StaticResource T.H1}"/>
            <TextBlock Text="进入世界之前，先签上你的名字。" Style="{StaticResource T.Soft}" Margin="0,4,0,16"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,8,18">
            <Border Style="{StaticResource Card.Hover}" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Microsoft_Click">
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource T.Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="微软账号登录" Style="{StaticResource T.H2}"/>
                        <TextBlock Text="正版玩家使用，可以进入正版服务器" Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card.Hover}" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="Offline_Click">
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource T.Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="离线账号" Style="{StaticResource T.H2}"/>
                        <TextBlock Text="只需要起一个名字，适合单人游戏" Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="使用" Style="{StaticResource Btn.Primary}" Padding="16,6" Margin="0,0,6,0" Tag="{Binding Account}"
                                                Click="Use_Click" Visibility="{Binding UseVisibility}"/>
                                        <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="&#xE74D;" ToolTip="移除账号" Tag="{Binding Account}" Click="Remove_Click"
                                                c:Ui.HoverBackground="{DynamicResource DangerSoftBrush}"/>
                                    </StackPanel>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Account.Initial}" FontFamily="{StaticResource SerifFont}" FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Account.Name}" FontWeight="SemiBold" FontSize="14.5"/>
                                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding CurrentVisibility}">
                                                <TextBlock Text="使用中" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Account.KindText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Account.Uuid, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Text="还没有账号，从上面选一种方式添加吧。" Style="{StaticResource T.Soft}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
