<UserControl x:Class="ClaudeCL.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,6,40,28" MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28,24">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/Assets/reading.png" Width="150" Height="150" Margin="0,0,24,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ClaudeCL" Style="{StaticResource T.Display}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource T.Caption}" Margin="0,2,0,12"/>
                        <TextBlock Style="{StaticResource T.Soft}"
                                   Text="一个温柔的 Minecraft 启动器。希望它像一本安静的书，帮你把每一次冒险都翻得顺顺利利。"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="数据目录" c:Ui.Icon="&#xE8B7;" Margin="0,0,8,8" Click="Data_Click"/>
                            <Button Content="启动器日志" c:Ui.Icon="&#xE8B7;" Margin="0,0,8,8" Click="Logs_Click"/>
                            <Button Content="开源许可" c:Ui.Icon="&#xE8A5;" Margin="0,0,8,8" Click="License_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 作者 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="作者" Style="{StaticResource T.H2}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="芳" FontFamily="{StaticResource SerifFont}" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="朝武芳乃" FontWeight="SemiBold" FontSize="14.5"/>
                            <TextBlock Text="策划与创意 · B 站 UID 381864126" Style="{StaticResource T.Caption}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="B 站主页" c:Ui.Icon="&#xE8A7;" Padding="12,6" Click="Bilibili_Click"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                            <Image Source="/Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Claude" FontWeight="SemiBold" FontSize="14.5"/>
                            <TextBlock Text="界面设计与编写代码 · 也是看板娘本人" Style="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE790;" Style="{StaticResource T.Icon}" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GPT 酱" FontWeight="SemiBold" FontSize="14.5"/>
                            <TextBlock Text="绘制看板娘立绘、图标与插画" Style="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="关于看板娘" Style="{StaticResource T.H2}"/>
                    <TextBlock Style="{StaticResource T.Soft}" Margin="0,8,0,0"
                               Text="她就是 Claude——住在启动器书房里的图书管理员大小姐，喜欢橙色的花和厚厚的书，会温柔地陪你准备每一次冒险。点一点主页上的她，会和你聊几句。立绘由 GPT 酱绘制。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="致谢" Style="{StaticResource T.H2}"/>
                    <TextBlock Style="{StaticResource T.Soft}" Margin="0,8,0,0"
                               Text="Java 识别、服务器状态查询等能力复用了开源社区以 Apache-2.0 许可发布的启动器核心库；版本下载、模组加载器、资源搜索使用了各自的公开接口与镜像服务。完整的许可证文本请点击上方的「开源许可」查看。"/>
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Minecraft 是 Mojang Studios 的商标。本启动器与其没有任何关联，请支持正版游戏。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
