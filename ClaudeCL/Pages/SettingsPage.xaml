<UserControl x:Class="ClaudeCL.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,6,40,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource T.H1}"/>
            <TextBlock Text="改动会自动保存。" Style="{StaticResource T.Soft}" Margin="0,4,0,18"/>

            <!-- 外观 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource T.H2}" Margin="0,0,0,14"/>
                    <TextBlock Text="配色" Style="{StaticResource T.Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Chip}" Content="奶油纸张" GroupName="Theme" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Chip}" Content="夜读灯光" GroupName="Theme" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Chip}" Content="跟随系统" GroupName="Theme" Checked="Theme_Checked"/>
                    </StackPanel>
                    <CheckBox x:Name="MascotCheck" Content="在主页显示看板娘" Margin="0,16,0,0" Click="Any_Changed"/>
                </StackPanel>
            </Border>

            <!-- 游戏 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="游戏" Style="{StaticResource T.H2}" Margin="0,0,0,14"/>

                    <TextBlock Text="游戏内存" Style="{StaticResource T.Label}"/>
                    <CheckBox x:Name="AutoMemCheck" Content="自动分配（推荐）" Click="Any_Changed"/>
                    <DockPanel x:Name="MemPanel" Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right" x:Name="MemText" Width="110" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Slider x:Name="MemSlider" Minimum="1024" Maximum="16384" SmallChange="256" LargeChange="1024"
                                TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="Mem_Changed"/>
                    </DockPanel>
                    <TextBlock x:Name="MemHint" Style="{StaticResource T.Caption}" Margin="0,6,0,0"/>

                    <TextBlock Text="Java" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="BrowseJava_Click"/>
                        <ComboBox x:Name="JavaBox" SelectionChanged="Java_Changed"/>
                    </DockPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="窗口宽度" Style="{StaticResource T.Label}"/>
                            <TextBox x:Name="WidthBox" LostFocus="Any_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="窗口高度" Style="{StaticResource T.Label}"/>
                            <TextBox x:Name="HeightBox" LostFocus="Any_Changed"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="FullscreenCheck" Content="全屏启动" Margin="0,12,0,0" Click="Any_Changed"/>
                    <CheckBox x:Name="IsolateCheck" Content="版本隔离：每个版本有自己独立的存档、模组和设置" Margin="0,12,0,0" Click="Any_Changed"/>
                    <CheckBox x:Name="CleanMemCheck" Content="启动游戏前自动清理内存（会弹出管理员授权）" Margin="0,12,0,0" Click="Any_Changed"/>

                    <TextBlock Text="游戏启动后，启动器" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
                    <ComboBox x:Name="AfterBox" SelectionChanged="Any_Changed" Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="保持打开"/>
                        <ComboBoxItem Content="最小化"/>
                        <ComboBoxItem Content="直接关闭"/>
                    </ComboBox>

                    <TextBlock Text="额外 JVM 参数" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
                    <TextBox x:Name="JvmBox" c:Ui.Placeholder="一般不需要填写" LostFocus="Any_Changed"/>
                    <TextBlock Text="额外游戏参数" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
                    <TextBox x:Name="GameArgsBox" c:Ui.Placeholder="例如 --server 服务器地址" LostFocus="Any_Changed"/>
                </StackPanel>
            </Border>

            <!-- 下载 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="下载" Style="{StaticResource T.H2}" Margin="0,0,0,14"/>
                    <TextBlock Text="下载源" Style="{StaticResource T.Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SrcAuto" Style="{StaticResource Chip}" Content="自动选择" GroupName="Src" Checked="Any_Changed"/>
                        <RadioButton x:Name="SrcMirror" Style="{StaticResource Chip}" Content="国内镜像优先" GroupName="Src" Checked="Any_Changed"/>
                        <RadioButton x:Name="SrcOfficial" Style="{StaticResource Chip}" Content="官方源优先" GroupName="Src" Checked="Any_Changed"/>
                    </StackPanel>
                    <TextBlock Text="同时下载的文件数" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="ThreadText" Width="60" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Slider x:Name="ThreadSlider" Minimum="4" Maximum="128" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="Thread_Changed"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 账号 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="微软登录" Style="{StaticResource T.H2}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="填写你在 Azure 门户注册的应用 Client ID：平台选择「移动和桌面应用程序」，重定向 URI 填 http://localhost，并申请游戏服务接口权限。登录时会直接打开微软网页授权。"/>
                    <TextBox x:Name="ClientIdBox" c:Ui.Placeholder="00000000-0000-0000-0000-000000000000" LostFocus="Any_Changed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
