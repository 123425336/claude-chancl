<UserControl x:Class="ClaudeCL.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClaudeCL.Controls">
    <Grid ClipToBounds="True">
        <!-- 背景插画 + 左侧柔光遮罩，保证文字清晰 -->
        <Image x:Name="BgImage" Source="/Assets/background.jpg" Stretch="UniformToFill" HorizontalAlignment="Right"
               RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.85"/>
        <Rectangle Fill="{DynamicResource HeroFadeBrush}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：问候与启动卡片 -->
            <DockPanel Margin="44,18,12,32">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="Greeting" Text="下午好" Style="{StaticResource T.Caption}" FontSize="13"/>
                    <TextBlock Text="今天想去哪里冒险？" Style="{StaticResource T.Display}" FontSize="34" Margin="0,6,0,8"/>
                    <TextBlock x:Name="Quote" Style="{StaticResource T.Soft}" MaxWidth="420" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" MaxWidth="460" HorizontalAlignment="Left">
                    <!-- 游戏运行中的提示条 -->
                    <Border x:Name="RunningBar" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed"
                            Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="结束" Style="{StaticResource Btn.Danger}" Padding="12,5" Margin="6,0,0,0" Click="Kill_Click"/>
                            <Button DockPanel.Dock="Right" Content="查看日志" Padding="12,5" Click="Log_Click"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="2,0,10,0"/>
                            <TextBlock x:Name="RunningText" Text="游戏运行中" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- 启动卡片 -->
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="即将启动" Style="{StaticResource T.Label}"/>
                            <ComboBox x:Name="VersionBox" MinHeight="44" SelectionChanged="VersionBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Caption}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="NoVersionHint" Visibility="Collapsed" Style="{StaticResource T.Soft}" Margin="2,4,0,0"
                                       Text="还没有安装任何版本，先去「下载游戏」挑一个吧。"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LaunchButton" Style="{StaticResource Btn.Primary}" Height="48" FontSize="16"
                                        c:Ui.Icon="&#xE768;" c:Ui.CornerRadius="12" Click="Launch_Click">
                                    <TextBlock x:Name="LaunchText" Text="启动游戏"/>
                                </Button>
                                <Button Grid.Column="1" Width="48" Height="48" Margin="10,0,0,0" Padding="0" c:Ui.CornerRadius="12"
                                        c:Ui.Icon="&#xE8B7;" ToolTip="打开游戏文件夹" Click="OpenFolder_Click"/>
                            </Grid>
                            <TextBlock x:Name="AccountLine" Style="{StaticResource T.Caption}" Margin="2,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 快捷入口 -->
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource Btn.Ghost}" Content="安装新版本" c:Ui.Icon="&#xE896;" Padding="12,7" Click="GoDownload_Click"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="找点模组" c:Ui.Icon="&#xEA86;" Padding="12,7" Click="GoResources_Click"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="管理模组" c:Ui.Icon="&#xE8F1;" Padding="12,7" Click="OpenMods_Click"/>
                        <Button x:Name="CleanMemButton" Style="{StaticResource Btn.Ghost}" Content="清理内存" c:Ui.Icon="&#xEA18;" Padding="12,7" Click="CleanMem_Click"/>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>

            <!-- 右侧：看板娘 -->
            <Grid x:Name="MascotArea" Grid.Column="1" Width="340" Margin="0,8,26,0">
                <Image x:Name="Mascot" Source="/Assets/mascot.png" VerticalAlignment="Bottom" Margin="0,40,0,-10"
                       RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" MouseLeftButtonUp="Mascot_Click"
                       RenderTransformOrigin="0.5,1">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MascotScale"/>
                            <TranslateTransform x:Name="MascotFloat"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <!-- 对话气泡 -->
                <Border x:Name="Bubble" Style="{StaticResource Card}" Padding="14,10" CornerRadius="14,14,14,4"
                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-20,24,0,0" MaxWidth="240"
                        Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,1">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="BubbleScale" ScaleX="0.9" ScaleY="0.9"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="BubbleText" Style="{StaticResource T.Body}" FontSize="13"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
