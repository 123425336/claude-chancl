<Window x:Class="ClaudeCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ClaudeCL.Controls"
        Title="ClaudeCL" Width="1120" Height="700" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource SansFont}" FontSize="13.5"
        Icon="Assets/app.ico" UseLayoutRounding="True" AllowDrop="True" PreviewDragEnter="Window_PreviewDragEnter"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 侧栏 ========== -->
        <Border Grid.Column="0" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,14">
                <!-- 标志 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,16,0,22">
                    <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True">
                        <Image Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ClaudeCL" Style="{StaticResource T.H2}" FontSize="19"/>
                        <TextBlock Text="温柔的方块世界向导" Style="{StaticResource T.Caption}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- 账号小卡片 -->
                <Button DockPanel.Dock="Bottom" x:Name="AccountCard" Click="AccountCard_Click" Padding="10,9"
                        HorizontalContentAlignment="Stretch" c:Ui.CornerRadius="12" ToolTip="管理账号">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock x:Name="AccountInitial" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource SerifFont}" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountName" Text="还没有账号" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AccountKind" Text="点击添加" Style="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- 导航 -->
                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource NavItem}" Content="主页" c:Ui.Icon="&#xE80F;" Tag="home" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="下载游戏" c:Ui.Icon="&#xE896;" Tag="download" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="资源中心" c:Ui.Icon="&#xEA86;" Tag="resources" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="版本管理" c:Ui.Icon="&#xE8F1;" Tag="versions" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="账号" c:Ui.Icon="&#xE77B;" Tag="accounts" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="小工具" c:Ui.Icon="&#xE774;" Tag="tools" Checked="Nav_Checked"/>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,10"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="设置" c:Ui.Icon="&#xE713;" Tag="settings" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="关于" c:Ui.Icon="&#xE946;" Tag="about" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== 右侧：标题栏 + 页面 ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="24,0,8,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource Btn.Caption}" c:Ui.Icon="&#xE708;" Click="Theme_Click" ToolTip="切换浅色 / 深色"/>
                    <Button Style="{StaticResource Btn.Caption}" c:Ui.Icon="&#xE921;" Click="Min_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" c:Ui.Icon="&#xE922;" Click="Max_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource Btn.Close}" c:Ui.Icon="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
                <TextBlock x:Name="PageTitle" Text="主页" VerticalAlignment="Center" Style="{StaticResource T.Caption}" FontSize="12.5"/>
            </DockPanel>

            <!-- 页面宿主：切换时淡入上浮 -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" RenderTransformOrigin="0.5,0">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ========== 全屏层（实时日志） ========== -->
        <Grid x:Name="OverlayLayer" Grid.ColumnSpan="2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="OverlayShift"/>
            </Grid.RenderTransform>
        </Grid>

        <!-- ========== 对话框层 ========== -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed"/>

        <!-- ========== 拖放层：把文件拖进窗口时出现 ========== -->
        <Grid x:Name="DropLayer" Grid.ColumnSpan="2" Visibility="Collapsed" AllowDrop="True" Background="{DynamicResource OverlayBrush}"
              DragOver="DropLayer_DragOver" DragLeave="DropLayer_DragLeave" Drop="DropLayer_Drop">
            <Grid Width="460" Height="330" IsHitTestVisible="False">
                <Rectangle RadiusX="22" RadiusY="22" Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource AccentBrush}"
                           StrokeThickness="2.5" StrokeDashArray="5 3"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0">
                    <Image Source="Assets/reading.png" Width="140" Height="140" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="松开就能安装" Style="{StaticResource T.H2}" FontSize="22" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="DropHint" Style="{StaticResource T.Soft}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========== 通知层（右下角） ========== -->
        <StackPanel x:Name="ToastLayer" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,22" IsHitTestVisible="False"/>

        <!-- ========== 启动画面 ========== -->
        <Grid x:Name="Splash" Grid.ColumnSpan="2" Background="{DynamicResource BgBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Assets/reading.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                <c:SparkLoader Width="34" Height="34" Margin="0,10,0,0"/>
                <TextBlock Text="ClaudeCL" Style="{StaticResource T.Display}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="SplashText" Text="正在翻开书页……" Style="{StaticResource T.Soft}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
